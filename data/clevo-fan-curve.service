# A systemd --user unit (installed under .../systemd/user/, enabled via
# `systemctl --user`), not a system unit -- deliberately, so this can
# only ever start once an actual interactive login session exists, never
# during early boot. A prior, unrelated incident (see
# ~/laptopissues/performance-mode/NOTES.md, "Incident (2026-08-08):
# abrupt shutdown") traced a hard power-off to a reverse-engineered EC
# command being issued from a *system* unit at early boot, in a less-
# initialized ACPI/EC state than any interactive testing had exercised.
# Performance-mode persistence was redesigned around the same rule
# (clevo_control_panel/app.py only ever touches it from an already-
# running, post-login app process) -- this unit follows the identical
# boundary. As a bonus, running as the real logged-in user (who setup-
# runtime.sh already adds to the clevoctl group) needs no DynamicUser/
# SupplementaryGroups trick at all, and sidesteps the repo-checkout-
# symlink-into-$HOME permission issue that combination had under
# DynamicUser's own unrelated ephemeral UID.
[Unit]
Description=Clevo Control Panel custom fan curve daemon
Documentation=https://github.com/arbitrary-string/clevo-control-panel
ConditionPathExists=/sys/devices/platform/CLV0001:00/fan1_manual_duty
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# Comfortable (3x) margin over the daemon's own configurable poll
# interval (clamped to a 1-30s range) -- WatchdogSec exists to catch a
# genuinely hung loop, not to race the configured sleep duration; a
# false trip at 30s with poll_interval_seconds also set to 30 would
# defeat the point (confirmed live: WATCHDOG=1 must be sent every
# iteration regardless of curve-enabled state -- see fan_curve.py).
WatchdogSec=90
ExecStart=/usr/bin/clevo-fan-curve-daemon
Restart=on-failure
RestartSec=2

# Confirmed live (2026-09-14): on a modern Ubuntu install, this daemon
# fails outright with "Failed to drop capabilities: Operation not
# permitted" / status=218/CAPABILITIES, before its own code ever runs.
# Root cause: ReadWritePaths=, CapabilityBoundingSet=, and the several
# Protect*= directives previously here all need systemd to transparently
# create a private, unprivileged user namespace to implement them for a
# non-root --user unit like this one -- and Ubuntu's `unprivileged_userns`
# AppArmor restriction (on by default) denies exactly that (confirmed via
# `sys_admin`/`setpcap` DENIED entries in the audit log). This isn't
# fixable by scoping a permissive AppArmor profile to this daemon's own
# binary: the failing prctl()/unshare() calls happen in systemd's own
# pre-exec child setup, *before* this daemon's binary is ever exec'd, so
# no profile attached to that binary can ever be consulted for them.
# Removed the directives that need this mechanism; kept everything below
# that's enforced via seccomp/prctl instead, which doesn't need a private
# namespace and isn't affected by this restriction at all. This daemon
# already runs as the plain logged-in user with no elevated privileges to
# begin with, so the removed directives were pure defense-in-depth against
# a hypothetical future bug in this code, not a response to any privilege
# it currently holds.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
