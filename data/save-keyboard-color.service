[Unit]
Description=Save keyboard backlight color and brightness before shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=/usr/bin/clevo-control-panel-cli keyboard save-state /var/lib/clevo-control-panel/state.json

[Install]
WantedBy=shutdown.target reboot.target halt.target
