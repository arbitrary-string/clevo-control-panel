# System76 (single-zone: one `color` file on the LED classdev itself)
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="system76_acpi::kbd_backlight", RUN+="/bin/chgrp clevoctl /sys%p/color", RUN+="/bin/chmod 0664 /sys%p/color", RUN+="/bin/chgrp clevoctl /sys%p/brightness", RUN+="/bin/chmod 0664 /sys%p/brightness"

# Generic Clevo/Tongfang (multi-zone: brightness on the LED classdev, per-zone
# `color_<zone>` files, plus (on drivers new enough to have them) battery
# charge threshold and performance mode files, on its parent platform device).
# The platform device itself is ACPI-enumerated at boot and persists across a
# driver reload (e.g. a DKMS rebuild), so only the driver *binding* re-fires
# on reload, as a `bind` uevent rather than `add` -- both are needed.
# charge_control_*/performance_mode files are suppressed with 2>/dev/null
# since older clevo-acpi builds don't have them.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="clevo-acpi::kbd_backlight", RUN+="/bin/chgrp clevoctl /sys%p/brightness", RUN+="/bin/chmod 0664 /sys%p/brightness"
ACTION=="add", SUBSYSTEM=="platform", DRIVER=="clevo-acpi", RUN+="/bin/sh -c 'chgrp clevoctl /sys%p/color_left /sys%p/color_center /sys%p/color_right /sys%p/color_numpad /sys%p/color_lightbar /sys%p/charge_control_start_threshold /sys%p/charge_control_end_threshold /sys%p/performance_mode /sys%p/fan1_manual_duty /sys%p/fan2_manual_duty /sys%p/fan3_manual_duty /sys%p/fan_watchdog_timeout_ms /sys%p/fan_watchdog_ping /sys%p/fan_release 2>/dev/null; chmod 0664 /sys%p/color_left /sys%p/color_center /sys%p/color_right /sys%p/color_numpad /sys%p/color_lightbar /sys%p/charge_control_start_threshold /sys%p/charge_control_end_threshold /sys%p/performance_mode /sys%p/fan1_manual_duty /sys%p/fan2_manual_duty /sys%p/fan3_manual_duty /sys%p/fan_watchdog_timeout_ms 2>/dev/null; chmod 0220 /sys%p/fan_watchdog_ping /sys%p/fan_release 2>/dev/null; true'"
ACTION=="bind", SUBSYSTEM=="platform", DRIVER=="clevo-acpi", RUN+="/bin/sh -c 'chgrp clevoctl /sys%p/color_left /sys%p/color_center /sys%p/color_right /sys%p/color_numpad /sys%p/color_lightbar /sys%p/charge_control_start_threshold /sys%p/charge_control_end_threshold /sys%p/performance_mode /sys%p/fan1_manual_duty /sys%p/fan2_manual_duty /sys%p/fan3_manual_duty /sys%p/fan_watchdog_timeout_ms /sys%p/fan_watchdog_ping /sys%p/fan_release 2>/dev/null; chmod 0664 /sys%p/color_left /sys%p/color_center /sys%p/color_right /sys%p/color_numpad /sys%p/color_lightbar /sys%p/charge_control_start_threshold /sys%p/charge_control_end_threshold /sys%p/performance_mode /sys%p/fan1_manual_duty /sys%p/fan2_manual_duty /sys%p/fan3_manual_duty /sys%p/fan_watchdog_timeout_ms 2>/dev/null; chmod 0220 /sys%p/fan_watchdog_ping /sys%p/fan_release 2>/dev/null; true'"
